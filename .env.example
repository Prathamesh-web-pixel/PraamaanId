# ==============================================================
# PramaanID — Safe Environment Variable Configuration Template
# NOTE: DO NOT COMMIT REAL SECRETS. Copy to .env for local runtime.
# ==============================================================

# Server Network & Host
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"

# Security & Cryptography (Server Only — Never expose to browser)
# SESSION_SECRET: Used for signing authenticated session cookies
SESSION_SECRET="dev_session_secret_32_chars_minimum_example_key_change_in_prod"

# ENCRYPTION_KEY: 256-bit (64 hex characters) key for AES-256-GCM vault encryption at rest
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Production Debug Mode (Must be false in production)
DEBUG=false

# External AI Services
# GEMINI_API_KEY: Automatically injected by AI Studio at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
